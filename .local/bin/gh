#!/usr/bin/env bash
# Prescriptive diagnostic wrapper for GitHub CLI (gh)
# Principles:
#   1. Zero aliases (no gh-checks wrapper)
#   2. No silent flag or argument rewriting
#   3. Prescriptive FuzzyCommandRunner-style hints on common agent mistakes
#   4. Normalizes `gh pr checks` Exit Code 8 (pending) -> Exit 0 with explicit status & next-step guidance
#   5. Bounds interactive `--watch` / `-w` and `gh run watch` to 180s across Linux and macOS
#   6. Defaults `GH_PAGER=cat` so non-TTY/agent invocations never block on interactive pagers

set -uo pipefail

export GH_PAGER="${GH_PAGER:-cat}"

# Resolve real gh binary on PATH (excluding this wrapper via inode identity -ef)
REAL_GH="${GH_WRAPPER_REAL_GH:-}"
if [[ -z "$REAL_GH" ]]; then
  while IFS= read -r candidate; do
    if [[ -n "$candidate" && ! "$candidate" -ef "${BASH_SOURCE[0]}" && -x "$candidate" ]]; then
      REAL_GH="$candidate"
      break
    fi
  done < <(type -ap gh 2>/dev/null)
fi

if [[ -z "$REAL_GH" ]]; then
  echo "Error: underlying 'gh' binary not found in PATH." >&2
  exit 127
fi

# Escape hatch for raw execution
if [[ "${GH_WRAPPER_RAW:-0}" == "1" ]]; then
  exec "$REAL_GH" "$@"
fi

# Normalize [HOST/]OWNER/REPO or GitHub remote URL into <owner>/<repo>
normalize_repo_slug() {
  local raw="${1%.git}"
  raw="${raw#https://github.com/}"
  raw="${raw#http://github.com/}"
  raw="${raw#ssh://git@github.com/}"
  raw="${raw#git@github.com:}"
  raw="${raw#github.com/}"
  echo "$raw"
}

# Helper: resolve default GitHub <owner>/<repo> (GH_REPO -> gh-resolved base remote -> origin)
resolve_github_repo() {
  if [[ -n "${GH_REPO:-}" ]]; then
    normalize_repo_slug "$GH_REPO"
    return
  fi
  local resolved_key remote_name remote_url origin_url
  resolved_key=$(git config --local --get-regexp '^remote\..*\.gh-resolved$' '^base$' 2>/dev/null | awk 'NR==1 {print $1}' || true)
  if [[ "$resolved_key" =~ ^remote\.(.+)\.gh-resolved$ ]]; then
    remote_name="${BASH_REMATCH[1]}"
    remote_url=$(git remote get-url "$remote_name" 2>/dev/null || true)
    if [[ "$remote_url" =~ github\.com[:/]([^/]+/[^/]+)$ ]]; then
      echo "${BASH_REMATCH[1]%.git}"
      return
    fi
  fi
  origin_url=$(git remote get-url origin 2>/dev/null || true)
  if [[ "$origin_url" =~ github\.com[:/]([^/]+/[^/]+)$ ]]; then
    local slug="${BASH_REMATCH[1]}"
    echo "${slug%.git}"
  fi
}

# Extract positional subcommands and explicit -R/--repo target (stopping option scan at --)
sub1=""
sub2=""
explicit_repo=""
expect_arg=""
end_of_opts=0
for arg in "$@"; do
  if [[ -n "$expect_arg" ]]; then
    if [[ "$expect_arg" == "repo" ]]; then
      explicit_repo="$(normalize_repo_slug "$arg")"
    fi
    expect_arg=""
    continue
  fi
  if [[ "$end_of_opts" -eq 0 ]]; then
    case "$arg" in
      --) end_of_opts=1; continue ;;
      -R|--repo) expect_arg="repo"; continue ;;
      -R=*|--repo=*) explicit_repo="$(normalize_repo_slug "${arg#*=}")"; continue ;;
      -R?*) explicit_repo="$(normalize_repo_slug "${arg#-R}")"; continue ;;
      --hostname) expect_arg="skip"; continue ;;
      --hostname=*) continue ;;
      -b|--body|-F|--body-file|-t|--title|-B|--base|-H|--head|-l|--label|-a|--assignee|-r|--reviewer|-p|--project|-m|--milestone|-T|--template)
        if [[ -n "$sub1" ]]; then
          expect_arg="skip"
        fi
        continue
        ;;
      -*) continue ;;
    esac
  fi
  if [[ -z "$sub1" ]]; then
    sub1="$arg"
  elif [[ -z "$sub2" ]]; then
    sub2="$arg"
  fi
done

# Bound interactive `--watch` / `pr checks -w` and `run watch` invocations to 180s
is_watch=0
has_json=0
if [[ "$sub1" == "run" && "$sub2" == "watch" ]]; then
  is_watch=1
fi
for arg in "$@"; do
  if [[ "$arg" == "--watch" || "$arg" == --watch=* ]]; then
    is_watch=1
  elif [[ "$sub1" == "pr" && "$sub2" == "checks" && "$arg" =~ ^-[a-zA-Z]*w[a-zA-Z]*$ ]]; then
    is_watch=1
  fi
  if [[ "$arg" == "--json" || "$arg" == --json=* ]]; then
    has_json=1
  fi
done

if [[ "$is_watch" -eq 1 ]]; then
  TIMEOUT_BIN="$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)"
  if [[ -n "$TIMEOUT_BIN" ]]; then
    "$TIMEOUT_BIN" --foreground --kill-after=2s 180s "$REAL_GH" "$@"
    wrc=$?
  else
    echo "⚠️  [gh] neither 'timeout' nor 'gtimeout' on PATH; watch is UNBOUNDED (brew install coreutils)" >&2
    "$REAL_GH" "$@"
    wrc=$?
  fi
  if [[ "$wrc" -eq 124 || "$wrc" -eq 137 ]]; then
    echo ""
    echo "⏳ [gh] Watch window (180s) elapsed while CI checks are still in progress."
    echo "💡 Next step: Yield and schedule an async timer (schedule tool), then run a single 'gh pr checks' snapshot."
    exit 0
  fi
  exit "$wrc"
fi

# Deterministic pre-PR local CI parity gate (`pr-check`) for `gh pr create` in `kevmoo/*` repos
if [[ "$sub1" == "pr" && "$sub2" == "create" && "${GH_SKIP_PR_CHECK:-0}" != "1" ]]; then
  repo_slug="${explicit_repo:-$(resolve_github_repo)}"
  if [[ "$repo_slug" == kevmoo/* && "$repo_slug" != "kevmoo/personal_dotfiles" && "$repo_slug" != "kevmoo/agent-relay" ]]; then
    PR_CHECK_BIN="$(command -v pr-check 2>/dev/null || echo "$HOME/.local/bin/pr-check")"
    if [[ -x "$PR_CHECK_BIN" ]]; then
      echo "🔍 [gh] Running pre-PR CI parity check ('pr-check') for $repo_slug..." >&2
      if ! "$PR_CHECK_BIN" >&2; then
        echo "" >&2
        echo "🛑 [gh] 'gh pr create' blocked because 'pr-check' found local CI parity violations." >&2
        echo "💡 Fix the violations above, commit, push, and re-run 'gh pr create' (or set GH_SKIP_PR_CHECK=1 to bypass)." >&2
        exit 1
      fi
    fi
  fi
fi

tmp_out=$(mktemp)
tmp_err=$(mktemp)
trap 'rm -f "$tmp_out" "$tmp_err"' EXIT

"$REAL_GH" "$@" >"$tmp_out" 2>"$tmp_err"
rc=$?

if [[ -s "$tmp_out" ]]; then
  cat "$tmp_out"
fi
if [[ -s "$tmp_err" ]]; then
  cat "$tmp_err" >&2
fi

# If command succeeded, exit 0 immediately
if [[ "$rc" -eq 0 ]]; then
  exit 0
fi

# 1. Prescriptive handling for `gh pr checks`
if [[ "$sub1" == "pr" && "$sub2" == "checks" ]]; then
  # Case A: Exit Code 8 (Checks pending/in-progress) -> Normalize to 0 with prescriptive guidance (unless --json is requested)
  if [[ "$rc" -eq 8 && "$has_json" -eq 0 ]]; then
    echo ""
    echo "⏳ [gh] CI STATUS: PENDING (Exit code 8 normalized to 0: checks are queued or running)."
    echo "💡 Next step: Do NOT poll in a bash sleep loop."
    echo "   • To wait reactively (bounded to 180s): gh run list --limit 5  ->  gh run watch <run-id>"
    echo "   • Or yield and schedule an async timer."
    exit 0
  fi

  # Case B: Exit Code 1 right after git push ("no checks reported on the '...' branch") (unless --json is requested)
  if [[ "$rc" -eq 1 && "$has_json" -eq 0 ]] && grep -q "no checks reported on the" "$tmp_out" "$tmp_err"; then
    echo ""
    echo "⏳ [gh] CI STATUS: STARTING (Exit code 1 normalized to 0: GitHub Actions has not registered check runs yet)."
    echo "💡 Next step: Wait ~15 seconds, then check active runs with: gh run list --limit 5"
    exit 0
  fi

  # Case C: Unknown JSON field "url" -> Prescriptive failure hint (keep Exit Code 1)
  if grep -q 'Unknown JSON field: "url"' "$tmp_out" "$tmp_err"; then
    echo "" >&2
    echo "💡 Prescriptive Hint: 'gh pr checks' uses 'link' instead of 'url' for check URLs." >&2
    echo "   Canonical invocation: gh pr checks --json name,state,link" >&2
    exit "$rc"
  fi
fi

# 2. Prescriptive hint for secondary Git worktrees missing default remote repository
if grep -q "No default remote repository has been set" "$tmp_out" "$tmp_err"; then
  repo_slug=$(resolve_github_repo)
  echo "" >&2
  if [[ -n "$repo_slug" ]]; then
    echo "💡 Prescriptive Hint (Git Worktree): No default repository is configured for this worktree." >&2
    echo "   Run once to configure permanently for this worktree:" >&2
    echo "     gh repo set-default origin" >&2
    echo "   Or pass explicitly: gh $* -R $repo_slug" >&2
  else
    echo "💡 Prescriptive Hint: Run 'gh repo set-default origin' or pass '-R <owner>/<repo>'." >&2
  fi
  exit "$rc"
fi

exit "$rc"
