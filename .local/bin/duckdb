#!/usr/bin/env bash
if [[ -n "${ANTIGRAVITY_AGENT:-}${CLAUDECODE:-}${GEMINI_CLI:-}${CURSOR_AGENT:-}" ]]; then
  export AI_AGENT=1
  set -- -batch -dark-mode "$@"
elif [[ ! -t 0 || ! -t 1 || "${PAGER:-}" == "cat" ]]; then
  set -- -dark-mode "$@"
fi
for bin in \
  "$HOME/.local/share/mise/installs/github-duckdb-duckdb/2/duckdb" \
  "$HOME/.local/share/mise/installs/duckdb/latest/duckdb"; do
  [[ -x "$bin" ]] && exec "$bin" "$@"
done
exec "$HOME/.local/share/mise/shims/duckdb" "$@"
