#!/bin/sh
set -eu

is_agent=0
if [ -n "${ANTIGRAVITY_AGENT:-}${CLAUDECODE:-}${GEMINI_CLI:-}${CURSOR_AGENT:-}${CODEX_CI:-}${CODEX_SANDBOX:-}${CODEX_THREAD_ID:-}${COPILOT_AGENT:-}${COPILOT_CLI:-}${COPILOT_AGENT_SESSION_ID:-}${AI_AGENT:-}${AGENT:-}" ]; then
  is_agent=1
fi

needs_theme=0
if [ ! -t 0 ] || [ ! -t 1 ] || [ "${PAGER:-}" = "cat" ] || [ "$is_agent" -eq 1 ]; then
  needs_theme=1
fi

has_theme=0
has_batch_or_interactive=0
has_manual=0
has_mode_or_utility=0
skip_next=0
for arg in "$@"; do
  if [ "$skip_next" -eq 1 ]; then
    skip_next=0
    continue
  fi
  case "$arg" in
    --)
      break
      ;;
    -dark-mode|--dark-mode|-light-mode|--light-mode)
      has_theme=1
      ;;
    -batch|--batch)
      has_batch_or_interactive=1
      ;;
    -interactive|--interactive)
      has_batch_or_interactive=1
      has_mode_or_utility=1
      ;;
    -cmd|--cmd|-c|--c|-f|--f|-init|--init|-newline|--newline|-nullvalue|--nullvalue|-s|--s|-separator|--separator|-storage-version|--storage-version)
      skip_next=1
      ;;
    -manual|--manual)
      has_manual=1
      has_mode_or_utility=1
      skip_next=1
      ;;
    -format-file|--format-file)
      has_mode_or_utility=1
      skip_next=1
      ;;
    -ascii|--ascii|-box|--box|-column|--column|-csv|--csv|-html|--html|-json|--json|-jsonlines|--jsonlines|-line|--line|-list|--list|-markdown|--markdown|-quote|--quote|-table|--table|-agent|--agent|-no-agent|--no-agent|-h|--h|-help|--help|-version|--version|-format|--format|-ui|--ui|-serve|--serve|-connect|--connect)
      has_mode_or_utility=1
      ;;
  esac
done

if [ "$needs_theme" -eq 1 ] && [ "$has_manual" -eq 1 ] && [ "$has_batch_or_interactive" -eq 0 ]; then
  set -- -batch "$@"
fi

if [ "$needs_theme" -eq 1 ] && [ "$has_theme" -eq 0 ]; then
  if [ "$#" -gt 0 ]; then
    set -- -dark-mode "$@"
  else
    set -- -dark-mode
  fi
fi

if [ "$is_agent" -eq 1 ] && [ "$has_mode_or_utility" -eq 0 ] && [ -z "${DUCKDB_AGENT_MODE:-}" ]; then
  export DUCKDB_AGENT_MODE=1
fi

for candidate in \
  "$HOME/.local/share/mise/installs/github-duckdb-duckdb/2/duckdb" \
  "$HOME/.local/share/mise/installs/github-duckdb-duckdb/latest/duckdb" \
  "$HOME/.local/share/mise/installs/duckdb/2/duckdb" \
  "$HOME/.local/share/mise/installs/duckdb/latest/duckdb" \
  "$HOME/.local/share/mise/shims/duckdb" \
  /opt/homebrew/bin/duckdb \
  /usr/local/bin/duckdb
do
  if [ "$candidate" != "$0" ] && [ -x "$candidate" ]; then
    if [ "$#" -gt 0 ]; then
      exec "$candidate" "$@"
    else
      exec "$candidate"
    fi
  fi
done

printf '%s\n' "duckdb: binary not found in mise installs, mise shims, or Homebrew" >&2
exit 127
