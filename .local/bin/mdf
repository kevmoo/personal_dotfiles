#!/usr/bin/env bash
# Standalone Markdown formatter wrapper around Prettier for user, scripts, and AI agents.
# Enforces 80-column line wrapping adhering to the markdown-long-lines standard.

set -euo pipefail

# Pre-normalize GitHub Flavored Markdown alerts (`> [!NOTE]`, `> [!TIP]`,
# `> [!IMPORTANT]`, `> [!WARNING]`, `> [!CAUTION]`) so Prettier's
# `--prose-wrap always` does not collapse `> [!TYPE]\n> Text` onto one line
# (which breaks GitHub Alert rendering on github.com).
if command -v python3 >/dev/null 2>&1 && [ "$#" -gt 0 ]; then
  python3 - "$@" <<'PY'
import os, re, sys

ALERT_INLINE_RE = re.compile(
    r"^([ \t]*>[ \t]*\[!(?:NOTE|TIP|IMPORTANT|WARNING|CAUTION)\])[ \t]+(\S.*)$"
)
ALERT_HEADER_RE = re.compile(
    r"^([ \t]*>[ \t]*\[!(?:NOTE|TIP|IMPORTANT|WARNING|CAUTION)\])[ \t]*$"
)

for arg in sys.argv[1:]:
    if arg.startswith("-") or not os.path.isfile(arg) or not arg.endswith(".md"):
        continue
    try:
        with open(arg, "r", encoding="utf-8") as f:
            orig = f.read()
    except Exception:
        continue
    lines = orig.splitlines(keepends=True)
    out = []
    i = 0
    changed = False
    while i < len(lines):
        line = lines[i]
        nl = "\r\n" if line.endswith("\r\n") else ("\n" if line.endswith("\n") else "\n")
        stripped = line.rstrip("\r\n")
        m_inline = ALERT_INLINE_RE.match(stripped)
        if m_inline:
            header, rest = m_inline.group(1), m_inline.group(2)
            prefix = header.split("[!")[0].rstrip()
            out.append(f"{header}{nl}")
            out.append(f"{prefix}{nl}")
            out.append(f"{prefix} {rest}{nl}")
            changed = True
            i += 1
            continue
        m_header = ALERT_HEADER_RE.match(stripped)
        if m_header and i + 1 < len(lines):
            next_stripped = lines[i + 1].rstrip("\r\n")
            if re.match(r"^[ \t]*>[ \t]+\S", next_stripped):
                header = m_header.group(1)
                prefix = header.split("[!")[0].rstrip()
                out.append(line)
                out.append(f"{prefix}{nl}")
                changed = True
                i += 1
                continue
        out.append(line)
        i += 1
    if changed:
        with open(arg, "w", encoding="utf-8") as f:
            f.write("".join(out))
PY
fi

# 1. Prefer mise-managed prettier if available
if command -v mise >/dev/null 2>&1; then
  if mise which prettier >/dev/null 2>&1; then
    exec mise exec -- prettier --write --config-precedence file-override \
      --prose-wrap always --print-width 80 "$@"
  fi
fi

# 2. Fallback to direct PATH prettier
if command -v prettier >/dev/null 2>&1; then
  exec prettier --write --config-precedence file-override \
    --prose-wrap always --print-width 80 "$@"
fi

# 3. Friendly, actionable error output if prettier is missing
echo "❌ Error: 'prettier' is not installed or not found in PATH." >&2
echo "" >&2
echo "To install prettier:" >&2
echo "  • via mise (preferred):  mise use -g npm:prettier" >&2
echo "  • via Homebrew:          brew install prettier" >&2
echo "  • via npm:               npm install -g prettier" >&2
exit 1
