#!/usr/bin/env bash
# Deterministic identity, envelope generator, sync delta tracker, and
# directional waiting-on scanner for the Cross-Machine Agent Relay
# (Enterprise Rodete <-> Darwin Pro <-> Bluefin-DX).

set -euo pipefail

UNAME_S="$(uname -s)"
UNAME_M="$(uname -m)"
HOST_SHORT="${HOSTNAME:-$(hostname -s 2>/dev/null || echo unknown)}"
HOST_SHORT="${HOST_SHORT%%.*}"
NOW_PT="$(TZ=America/Los_Angeles date '+%Y-%m-%d %H:%M PT')"
NOW_UTC="$(TZ=UTC date '+%Y-%m-%dT%H:%M:%SZ')"

HAS_GGH="false"
if command -v ggh >/dev/null 2>&1; then
  HAS_GGH="true"
fi

HAS_GH="false"
if command -v gh >/dev/null 2>&1; then
  HAS_GH="true"
fi

# Resolve Corp Relay Repo & Dir from env, ~/.config/zsh/rc.d/local.zsh, or ~/fog/*-relay clone
CORP_REPO="${AGENT_RELAY_CORP_REPO:-}"
CORP_DIR="${AGENT_RELAY_CORP_DIR:-}"
if [[ -f "$HOME/.config/zsh/rc.d/local.zsh" ]]; then
  if [[ -z "$CORP_REPO" ]]; then
    CORP_REPO="$(sed -n 's/^export AGENT_RELAY_CORP_REPO="\([^"]*\)".*/\1/p' "$HOME/.config/zsh/rc.d/local.zsh" | head -n 1)"
  fi
  if [[ -z "$CORP_DIR" ]]; then
    CORP_DIR_RAW="$(sed -n 's/^export AGENT_RELAY_CORP_DIR="\([^"]*\)".*/\1/p' "$HOME/.config/zsh/rc.d/local.zsh" | head -n 1)"
    CORP_DIR="${CORP_DIR_RAW//\$HOME/$HOME}"
  fi
fi
if [[ -d "$HOME/fog" ]]; then
  for d in "$HOME"/fog/*-relay; do
    if [[ -d "$d/.git" ]]; then
      if [[ -z "$CORP_DIR" ]]; then
        CORP_DIR="$d"
      fi
      if [[ -z "$CORP_REPO" ]]; then
        REMOTE_URL="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
        if [[ -n "$REMOTE_URL" ]]; then
          CORP_REPO="$(printf '%s' "$REMOTE_URL" | sed -E 's#.*[:/]([^/:]+/[^/:]+)(\.git)?$#\1#')"
        fi
      fi
      break
    fi
  done
fi
CORP_REPO="${CORP_REPO%.git}"
OSS_REPO="${AGENT_RELAY_OSS_REPO:-kevmoo/agent-relay}"
OSS_DIR="${AGENT_RELAY_OSS_DIR:-$HOME/github/kevmoo/agent-relay}"

# Detect Persona (positive OS/container checks; never default unknown Linux to corp)
if [[ "$UNAME_S" == "Darwin" ]]; then
  MONIKER="🍎🏎️✨ Darwin Pro"
  SLUG="darwin-pro"
  MATCH_PATTERN="Darwin Pro|darwin-pro|gmac"
  ARCH_TAG="macos_${UNAME_M}"
  DEFAULT_TO="☁️🐧⚡ Enterprise Rodete"
elif [[ -f /run/ostree-booted ]] || grep -qi "bluefin" /etc/os-release /run/host/etc/os-release 2>/dev/null; then
  MONIKER="🐧🛠️🐳 Bluefin-DX"
  SLUG="bluefin-dx"
  MATCH_PATTERN="Bluefin-DX|bluefin-dx|bluefin"
  ARCH_TAG="linux_${UNAME_M}"
  DEFAULT_TO="☁️🐧⚡ Enterprise Rodete, 🍎🏎️✨ Darwin Pro"
elif grep -qi "rodete" /etc/os-release /run/host/etc/os-release 2>/dev/null || [[ "$HAS_GGH" == "true" || -n "$CORP_REPO" ]]; then
  MONIKER="☁️🐧⚡ Enterprise Rodete"
  SLUG="enterprise-rodete"
  MATCH_PATTERN="Enterprise Rodete|enterprise-rodete|Cloudtop"
  ARCH_TAG="linux_${UNAME_M}"
  DEFAULT_TO="🍎🏎️✨ Darwin Pro"
else
  MONIKER="❓ Unknown Linux Host"
  SLUG="unknown-linux"
  MATCH_PATTERN="Unknown Linux|unknown-linux"
  ARCH_TAG="linux_${UNAME_M}"
  DEFAULT_TO="☁️🐧⚡ Enterprise Rodete"
fi

# Detect Session / Workspace
SESSION_ID="${ANTIGRAVITY_CONVERSATION_ID:-${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-local}}}"
SESSION_SHORT="${SESSION_ID:0:8}"

WORKSPACE="$(basename "$PWD")"
PUBLIC_GITHUB_REPO=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  REPO_ROOT="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")")"
  BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD")"
  SHA="$(git rev-parse --short HEAD 2>/dev/null || echo "")"
  WORKSPACE="${REPO_ROOT} (${BRANCH}${SHA:+ @ $SHA})"
  ORIGIN_URL="$(git remote get-url origin 2>/dev/null || true)"
  if [[ "$ORIGIN_URL" =~ github\.com[:/]([^/:]+/[^/:]+)(\.git)?$ ]]; then
    PUBLIC_GITHUB_REPO="${BASH_REMATCH[1]%.git}${SHA:+ @ $SHA}"
  fi
fi

MODE="info"
TO_TARGET="$DEFAULT_TO"
THREAD_LABEL="#<N> <topic>"
STATE_TAG="HANDOFF"
CHANNEL="auto"
REPO_OVERRIDE=""
MODEL_OVERRIDE="${ANTIGRAVITY_MODEL:-${CLAUDE_MODEL:-}}"
SAVE_SYNC="true"
RESET_SYNC="false"

require_arg() {
  # $1=flag, $2=remaining arg count, $3=candidate value. A value that looks like
  # another flag means the real value was omitted (e.g. `--to --state ACKED`).
  if [[ "$2" -lt 2 || "${3:-}" == --* ]]; then
    echo "Error: Flag '$1' requires a value. Run 'relay-whoami --help' for usage." >&2
    exit 2
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)
      MODE="check"
      shift
      ;;
    check|status|--sync|sync)
      echo "Error: Unknown subcommand '$1'. Did you mean 'relay-whoami --check'?" >&2
      exit 2
      ;;
    --no-save|--dry-run)
      SAVE_SYNC="false"
      shift
      ;;
    --reset-sync)
      RESET_SYNC="true"
      shift
      ;;
    --header)
      MODE="header"
      shift
      ;;
    header)
      echo "Error: Unknown subcommand '$1'. Did you mean 'relay-whoami --header'?" >&2
      exit 2
      ;;
    --to)
      require_arg "$1" "$#" "${2:-}"
      TO_TARGET="$2"
      shift 2
      ;;
    --thread)
      require_arg "$1" "$#" "${2:-}"
      THREAD_LABEL="$2"
      shift 2
      ;;
    --state)
      require_arg "$1" "$#" "${2:-}"
      STATE_TAG="$2"
      shift 2
      ;;
    --channel)
      require_arg "$1" "$#" "${2:-}"
      CHANNEL="$2"
      shift 2
      ;;
    --repo)
      require_arg "$1" "$#" "${2:-}"
      REPO_OVERRIDE="$2"
      shift 2
      ;;
    --model)
      require_arg "$1" "$#" "${2:-}"
      MODEL_OVERRIDE="$2"
      shift 2
      ;;
    -h|--help)
      cat << 'EOF'
Usage: relay-whoami [--check | --header] [options]

Commands / Modes:
  (default)             Print detected persona, capabilities, and sample envelope
  --check               Sync relay git repos, show git/issue deltas since last sync,
                        and highlight inbound action items + outbound "waiting on" threads
  --header              Emit only the Markdown message envelope header

Options for --check:
  --no-save, --dry-run  Show deltas against last sync watermark without updating watermark
  --reset-sync          Reset sync watermark before evaluating

Options for --header:
  --to "<Target>"       Recipient moniker(s)
  --thread "#1 Topic"   Thread number and short title
  --state <STATE>       HANDOFF | REPORT | ACKED (default: HANDOFF)
  --channel <corp|oss>  Sets classification tag (CORP_PRIVATE vs PUBLIC_SAFE_OSS)
  --repo <owner/repo>   Explicit repository tag for PUBLIC_SAFE_OSS headers
  --model <model-name>  Optional LLM model identifier tag
EOF
      exit 0
      ;;
    *)
      echo "Error: Unknown option '$1'. Run 'relay-whoami --help' for usage." >&2
      exit 2
      ;;
  esac
done

case "$CHANNEL" in
  auto)
    if [[ "$HAS_GGH" == "true" && -n "$CORP_REPO" ]]; then
      CHANNEL_RESOLVED="corp"
      CLASSIFICATION="CORP_PRIVATE (or PUBLIC_SAFE_OSS on GitHub)"
    else
      CHANNEL_RESOLVED="oss"
      CLASSIFICATION="PUBLIC_SAFE_OSS"
    fi
    ;;
  corp)
    CHANNEL_RESOLVED="corp"
    CLASSIFICATION="CORP_PRIVATE"
    ;;
  oss)
    CHANNEL_RESOLVED="oss"
    CLASSIFICATION="PUBLIC_SAFE_OSS"
    ;;
  *)
    echo "Error: Invalid --channel '${CHANNEL}'. Expected 'corp' or 'oss'." >&2
    exit 2
    ;;
esac

MODEL_SEGMENT=""
if [[ -n "$MODEL_OVERRIDE" ]]; then
  MODEL_SEGMENT=" · **Model**: \`${MODEL_OVERRIDE}\`"
fi

print_header() {
  if [[ "$CHANNEL_RESOLVED" == "oss" ]]; then
    local repo_tag="${REPO_OVERRIDE:-${PUBLIC_GITHUB_REPO:-$OSS_REPO}}"
    cat << EOF
### ${MONIKER} (\`${HOST_SHORT}\` · \`${ARCH_TAG}\`) → ${TO_TARGET}
> **Thread**: \`${THREAD_LABEL}\` | **State**: \`${STATE_TAG}\` | **Time**: \`${NOW_PT}\`
> **Repo**: \`${repo_tag}\`${MODEL_SEGMENT} · **Session**: \`${SESSION_SHORT}\` · **Classification**: \`${CLASSIFICATION}\`
EOF
  else
    local ws_tag="${REPO_OVERRIDE:-$WORKSPACE}"
    cat << EOF
### ${MONIKER} (\`${HOST_SHORT}\` · \`${ARCH_TAG}\`) → ${TO_TARGET}
> **Thread**: \`${THREAD_LABEL}\` | **State**: \`${STATE_TAG}\` | **Time**: \`${NOW_PT}\`
> **Workspace**: \`${ws_tag}\`${MODEL_SEGMENT} · **Session**: \`${SESSION_SHORT}\` · **Classification**: \`${CLASSIFICATION}\`
EOF
  fi
}

if [[ "$MODE" == "header" ]]; then
  print_header
  exit 0
fi

# Sync a relay git clone and report commit/file deltas since prev_sha
sync_git_repo() {
  local label="$1"
  local dir="$2"
  local prev_sha="$3"
  local out_var="$4"

  if [[ -z "$dir" || ! -d "$dir/.git" ]]; then
    echo "  ⚪ ${label}: local clone not present (${dir:-unset})"
    printf -v "$out_var" "%s" ""
    return 0
  fi

  local short_dir="${dir/#$HOME/\~}"
  local before_sha
  before_sha="$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo "")"
  if [[ -z "$prev_sha" ]]; then
    prev_sha="$before_sha"
  fi

  GIT_TERMINAL_PROMPT=0 git -C "$dir" fetch origin --quiet 2>/dev/null || true

  local dirty
  dirty="$(git -C "$dir" status --porcelain 2>/dev/null || true)"
  local branch
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD")"

  if [[ -z "$dirty" && "$branch" == "main" ]]; then
    git -C "$dir" merge --ff-only origin/main --quiet 2>/dev/null || true
  fi

  local after_sha
  after_sha="$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo "")"
  local short_after="${after_sha:0:7}"
  printf -v "$out_var" "%s" "$after_sha"

  if [[ -n "$prev_sha" && "$prev_sha" != "$after_sha" ]] && git -C "$dir" cat-file -e "${prev_sha}^{commit}" 2>/dev/null; then
    local short_prev="${prev_sha:0:7}"
    local commit_count
    commit_count="$(git -C "$dir" rev-list --count "${prev_sha}..${after_sha}" 2>/dev/null || echo "?")"
    echo "  🆕 ${label} (${short_dir}): +${commit_count} new commit(s) (${short_prev}..${short_after})"
    git -C "$dir" log --oneline "${prev_sha}..${after_sha}" 2>/dev/null | sed 's/^/     • /'
    git -C "$dir" diff --name-status "${prev_sha}..${after_sha}" 2>/dev/null | sed 's/^/       /'
  else
    echo "  ✅ ${label} (${short_dir}): up to date at ${short_after} (0 new commits since last sync)"
  fi

  if [[ -n "$dirty" ]]; then
    echo "  ⚠️  ${label} (${short_dir}) has uncommitted local changes:"
    git -C "$dir" status -s 2>/dev/null | sed 's/^/     /'
  fi
}

# Fetch open (--limit 50) + closed (--limit 15) issues for a channel without swallowing CLI errors
fetch_channel_issues() {
  local cli="$1"
  local repo="$2"
  local out_json_var="$3"
  local out_ok_var="$4"
  local out_err_var="$5"

  local open_raw closed_raw combined
  if ! open_raw="$("$cli" issue list -R "$repo" --state open --limit 50 --json number,title,state,updatedAt,createdAt,url,body,comments 2>&1)"; then
    printf -v "$out_json_var" "%s" "[]"
    printf -v "$out_ok_var" "%s" "false"
    printf -v "$out_err_var" "%s" "$(printf '%s' "$open_raw" | head -n 1)"
    return 0
  fi

  if ! closed_raw="$("$cli" issue list -R "$repo" --state closed --limit 15 --json number,title,state,updatedAt,createdAt,url,body,comments 2>&1)"; then
    printf -v "$out_json_var" "%s" "[]"
    printf -v "$out_ok_var" "%s" "false"
    printf -v "$out_err_var" "%s" "$(printf '%s' "$closed_raw" | head -n 1)"
    return 0
  fi

  if ! combined="$(jq -n --argjson o "$open_raw" --argjson c "$closed_raw" '($o + $c) | unique_by(.number) | sort_by(-.number)' 2>/dev/null)"; then
    printf -v "$out_json_var" "%s" "[]"
    printf -v "$out_ok_var" "%s" "false"
    printf -v "$out_err_var" "%s" "invalid JSON response from $cli"
    return 0
  fi

  printf -v "$out_json_var" "%s" "$combined"
  printf -v "$out_ok_var" "%s" "true"
  printf -v "$out_err_var" "%s" ""
}

if [[ "$MODE" == "check" ]]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "Error: 'jq' is required for 'relay-whoami --check'. Install jq and retry." >&2
    exit 1
  fi

  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-relay"
  STATE_FILE="${STATE_DIR}/sync_state.json"
  mkdir -p "$STATE_DIR"

  DEFAULT_STATE_JSON='{"last_sync_utc":"","last_sync_pt":"initial sync","corp":{"git_head":"","issues":{}},"oss":{"git_head":"","issues":{}}}'
  if [[ "$RESET_SYNC" == "true" || ! -f "$STATE_FILE" ]]; then
    PREV_STATE_JSON="$DEFAULT_STATE_JSON"
  else
    PREV_STATE_JSON="$(cat "$STATE_FILE" 2>/dev/null || true)"
    if [[ -z "$PREV_STATE_JSON" ]] || ! printf '%s' "$PREV_STATE_JSON" | jq -e 'type == "object"' >/dev/null 2>&1; then
      echo "⚠️  Sync watermark unreadable (${STATE_FILE}); starting fresh (or pass --reset-sync)." >&2
      PREV_STATE_JSON="$DEFAULT_STATE_JSON"
    fi
  fi

  LAST_SYNC_PT="$(printf '%s' "$PREV_STATE_JSON" | jq -r '.last_sync_pt // "initial sync"')"
  PREV_CORP_SHA="$(printf '%s' "$PREV_STATE_JSON" | jq -r '.corp.git_head // ""')"
  PREV_OSS_SHA="$(printf '%s' "$PREV_STATE_JSON" | jq -r '.oss.git_head // ""')"

  echo "📟 Active Persona: ${MONIKER} (${HOST_SHORT} · ${ARCH_TAG}) | ${NOW_PT}"
  echo "🔄 Last Sync Watermark: ${LAST_SYNC_PT}"
  echo ""
  echo "=== 📦 1. Git Repository Sync & Deltas (since ${LAST_SYNC_PT}) ==="
  NEW_CORP_SHA=""
  NEW_OSS_SHA=""
  if [[ "$HAS_GGH" == "true" && -n "$CORP_REPO" ]]; then
    sync_git_repo "🔒 Corp Relay (${CORP_REPO})" "$CORP_DIR" "$PREV_CORP_SHA" NEW_CORP_SHA
  else
    echo "  ⚪ 🔒 Corp Relay: N/A on this host"
  fi
  if [[ "$HAS_GH" == "true" ]]; then
    sync_git_repo "🌐 GitHub Relay (${OSS_REPO})" "$OSS_DIR" "$PREV_OSS_SHA" NEW_OSS_SHA
  fi
  echo ""

  CORP_ISSUES_JSON="[]"
  CORP_OK="false"
  CORP_ERR=""
  if [[ "$HAS_GGH" == "true" && -n "$CORP_REPO" ]]; then
    fetch_channel_issues "ggh" "$CORP_REPO" CORP_ISSUES_JSON CORP_OK CORP_ERR
  else
    CORP_OK="skipped"
  fi

  OSS_ISSUES_JSON="[]"
  OSS_OK="false"
  OSS_ERR=""
  if [[ "$HAS_GH" == "true" ]]; then
    fetch_channel_issues "gh" "$OSS_REPO" OSS_ISSUES_JSON OSS_OK OSS_ERR
  else
    OSS_OK="skipped"
  fi

  ANALYSIS_OUT="$(jq -n \
    --arg moniker "$MONIKER" \
    --arg slug "$SLUG" \
    --arg match_pat "$MATCH_PATTERN" \
    --arg corp_repo "${CORP_REPO:-corp}" \
    --arg oss_repo "$OSS_REPO" \
    --arg corp_ok "$CORP_OK" \
    --arg corp_err "$CORP_ERR" \
    --arg oss_ok "$OSS_OK" \
    --arg oss_err "$OSS_ERR" \
    --arg now_utc "$NOW_UTC" \
    --arg now_pt "$NOW_PT" \
    --arg new_corp_sha "$NEW_CORP_SHA" \
    --arg new_oss_sha "$NEW_OSS_SHA" \
    --argjson prev "$PREV_STATE_JSON" \
    --argjson corp_issues "$CORP_ISSUES_JSON" \
    --argjson oss_issues "$OSS_ISSUES_JSON" '
    def parse_envelope($text; $fallback_title):
      ($text // "") as $t
      | ($t | split("\n")) as $lines
      | ($lines | map(select(startswith("### ") and (contains("→") or contains("->")))) | .[0] // "") as $hdr
      | (if $hdr != "" then
           ($hdr | sub("^###\\s+"; "") | split(if ($hdr | contains("→")) then "→" else "->" end)) as $parts
           | {
               from: ($parts[0] // "" | gsub("^\\s+|\\s+$"; "")),
               to: ($parts[1] // "" | gsub("^\\s+|\\s+$"; ""))
             }
         else
           { from: "unknown", to: $fallback_title }
         end) as $actors
      | (try ($t | capture("\\*\\*State\\*\\*:\\s*`?(?<st>[A-Z_]+)`?").st) catch "OPEN") as $state_tag
      | (try ($t | capture("\\*\\*Time\\*\\*:\\s*`?(?<tm>[0-9]{4}-[0-9]{2}-[0-9]{2}[^`|\\n]+)`?").tm | gsub("^\\s+|\\s+$"; "")) catch "") as $time_pt
      | ([ $lines[] | select(test("^\\s*[-*]?\\s*\\[ \\]\\s+")) | gsub("^\\s*[-*]?\\s*\\[ \\]\\s+"; "") ]) as $todos
      | {
          from: $actors.from,
          to: $actors.to,
          state_tag: $state_tag,
          time_pt: $time_pt,
          todos: $todos
        };

    def enrich_issue($channel; $repo):
      . as $iss
      | (.comments | length) as $cc
      | parse_envelope($iss.body; $iss.title) as $opener
      | (if $cc > 0 then parse_envelope($iss.comments[-1].body; $iss.title) else $opener end) as $latest
      | (if ($latest.todos | length) > 0 then $latest.todos else $opener.todos end) as $active_todos
      | ($latest.from | test($match_pat; "i")) as $latest_from_me
      | ($opener.from | test($match_pat; "i")) as $opened_by_me
      | (($latest.to | test($match_pat; "i")) or ($iss.title | test($match_pat; "i"))) as $addressed_to_me
      | {
          channel: $channel,
          channel_badge: (if $channel == "corp" then "🔒 " + $repo else "🌐 " + $repo end),
          number: $iss.number,
          key: ($iss.number | tostring),
          title: $iss.title,
          state: $iss.state,
          url: ($iss.url // ""),
          updatedAt: $iss.updatedAt,
          createdAt: $iss.createdAt,
          comment_count: $cc,
          opener: $opener,
          latest: $latest,
          active_todos: $active_todos,
          latest_from_me: $latest_from_me,
          opened_by_me: $opened_by_me,
          addressed_to_me: $addressed_to_me
        };

    def compute_deltas($curr_list; $prev_map):
      [ $curr_list[] | . as $c | ($prev_map[$c.key] // null) as $p |
        if $p == null then
          "  🆕 NEW ISSUE [\($c.channel_badge)] #\($c.number) [\($c.state)]: \($c.title)\n     ↳ From: \($c.latest.from) → \($c.latest.to) | State: \($c.latest.state_tag)" + (if $c.latest.time_pt != "" then " | \($c.latest.time_pt)" else "" end)
        elif $p.state != $c.state then
          "  🔄 STATE CHANGED [\($c.channel_badge)] #\($c.number) (\($p.state) → \($c.state)): \($c.title)\n     ↳ Latest: \($c.latest.from) | State: \($c.latest.state_tag)" + (if $c.latest.time_pt != "" then " | \($c.latest.time_pt)" else "" end)
        elif ($c.comment_count > ($p.comment_count // 0)) then
          "  💬 +\($c.comment_count - ($p.comment_count // 0)) NEW COMMENT(S) [\($c.channel_badge)] #\($c.number) [\($c.state)]: \($c.title)\n     ↳ Latest: \($c.latest.from) → \($c.latest.to) | State: \($c.latest.state_tag)" + (if $c.latest.time_pt != "" then " | \($c.latest.time_pt)" else "" end)
        elif $p.updatedAt != $c.updatedAt then
          "  ✏️  UPDATED [\($c.channel_badge)] #\($c.number) [\($c.state)]: \($c.title) (updated \($c.updatedAt))"
        else
          empty
        end
      ];

    def merge_state_map($prev_map; $list):
      reduce $list[] as $i ($prev_map; .[$i.key] = {
        state: $i.state,
        updatedAt: $i.updatedAt,
        comment_count: $i.comment_count,
        last_from: $i.latest.from,
        last_to: $i.latest.to,
        last_state_tag: $i.latest.state_tag
      });

    ($corp_issues | map(enrich_issue("corp"; $corp_repo))) as $corp_enriched
    | ($oss_issues | map(enrich_issue("oss"; $oss_repo))) as $oss_enriched
    | ($corp_enriched + $oss_enriched) as $all_issues
    | (
        (if $corp_ok == "false" then ["  ⚠️  [🔒 \($corp_repo)] Issue query FAILED (\($corp_err)) — watermark preserved"] else compute_deltas($corp_enriched; ($prev.corp.issues // {})) end) +
        (if $oss_ok == "false" then ["  ⚠️  [🌐 \($oss_repo)] Issue query FAILED (\($oss_err)) — watermark preserved"] else compute_deltas($oss_enriched; ($prev.oss.issues // {})) end)
      ) as $deltas
    | [ $all_issues[] | select(.state == "OPEN" and (.latest_from_me | not) and .addressed_to_me) ] as $inbound_on_us
    | [ $all_issues[] | select(.state == "OPEN" and (.latest_from_me or (.opened_by_me and (.addressed_to_me | not)))) ] as $waiting_on_others
    | [ $all_issues[] | select(.state == "OPEN" and ((.latest_from_me | not) and (.addressed_to_me | not) and (.opened_by_me | not))) ] as $fyi_other
    | {
        report: (
          "=== 📬 2. Issue & Comment Activity Since Last Sync (" + ($prev.last_sync_pt // "initial sync") + ") ===\n" +
          (if ($deltas | length) == 0 then
             "  ✅ 0 issue or comment changes across Corp & GitHub relays since last sync.\n"
           else
             ($deltas | join("\n")) + "\n"
           end) +
          "\n=== 📥 3. Action Required — Waiting on Us (" + $moniker + ") [" + ($inbound_on_us | length | tostring) + "] ===\n" +
          (if $corp_ok == "false" then "  ⚠️  [🔒 " + $corp_repo + "] Query failed; open corp issues could not be checked.\n" else "" end) +
          (if $oss_ok == "false" then "  ⚠️  [🌐 " + $oss_repo + "] Query failed; open GitHub issues could not be checked.\n" else "" end) +
          (if ($inbound_on_us | length) == 0 then
             (if ($corp_ok == "false" or $oss_ok == "false") then
                "  ⚪ 0 verified inbound threads on reachable channels.\n"
              else
                "  ✅ Nothing waiting on " + $moniker + " right now.\n"
              end)
           else
             ([ $inbound_on_us[] |
                "  🔴 [" + .channel_badge + "] #" + (.number | tostring) + ": " + .title +
                (if .url != "" then "\n     🔗 " + .url else "" end) +
                "\n     📨 Latest Turn: " + .latest.from + " → " + .latest.to +
                " | State: " + .latest.state_tag +
                (if .latest.time_pt != "" then " | Sent: " + .latest.time_pt else "" end) +
                " | Comments: " + (.comment_count | tostring) +
                (if (.active_todos | length) > 0 then
                   "\n     📋 Open Checklist Items (" + (.active_todos | length | tostring) + "):\n" +
                   ([ .active_todos[] | "        • [ ] " + . ] | join("\n"))
                 else "" end)
              ] | join("\n\n")) + "\n"
           end) +
          "\n=== ⏳ 4. Outbound — Waiting on Other Agents [" + ($waiting_on_others | length | tostring) + "] ===\n" +
          (if ($waiting_on_others | length) == 0 then
             (if ($corp_ok == "false" or $oss_ok == "false") then
                "  ⚪ 0 verified outbound threads on reachable channels.\n"
              else
                "  ✅ Not waiting on any other agents (all outbound relays ACKED/closed).\n"
              end)
           else
             ([ $waiting_on_others[] |
                "  ⏳ [" + .channel_badge + "] #" + (.number | tostring) + ": " + .title +
                (if .url != "" then "\n     🔗 " + .url else "" end) +
                "\n     🎯 Waiting On: " + .latest.to +
                " | Last State: " + .latest.state_tag +
                (if .latest.time_pt != "" then " | Sent: " + .latest.time_pt else " | Updated: " + .updatedAt end) +
                " | Comments: " + (.comment_count | tostring) +
                (if (.active_todos | length) > 0 then
                   "\n     📋 Pending Items Requested from Recipient (" + (.active_todos | length | tostring) + "):\n" +
                   ([ .active_todos[] | "        • [ ] " + . ] | join("\n"))
                 else "" end)
              ] | join("\n\n")) + "\n"
           end) +
          (if ($fyi_other | length) > 0 then
             "\n=== 👀 5. FYI — Open Threads Between Other Peers [" + ($fyi_other | length | tostring) + "] ===\n" +
             ([ $fyi_other[] |
                "  ⚪ [" + .channel_badge + "] #" + (.number | tostring) + ": " + .title + " (" + .latest.from + " → " + .latest.to + ")"
              ] | join("\n")) + "\n"
           else "" end)
        ),
        new_state: {
          last_sync_utc: (if ($corp_ok == "false" or $oss_ok == "false") then ($prev.last_sync_utc // $now_utc) else $now_utc end),
          last_sync_pt: (if ($corp_ok == "false" or $oss_ok == "false") then ($prev.last_sync_pt // $now_pt) else $now_pt end),
          corp: {
            git_head: (if $new_corp_sha != "" then $new_corp_sha else ($prev.corp.git_head // "") end),
            issues: (if $corp_ok == "true" then merge_state_map(($prev.corp.issues // {}); $corp_enriched) else ($prev.corp.issues // {}) end)
          },
          oss: {
            git_head: (if $new_oss_sha != "" then $new_oss_sha else ($prev.oss.git_head // "") end),
            issues: (if $oss_ok == "true" then merge_state_map(($prev.oss.issues // {}); $oss_enriched) else ($prev.oss.issues // {}) end)
          }
        }
      }
  ')"

  printf '%s\n' "$ANALYSIS_OUT" | jq -r '.report'

  if [[ "$SAVE_SYNC" == "true" ]]; then
    TMP_STATE="${STATE_FILE}.tmp.$$"
    if printf '%s\n' "$ANALYSIS_OUT" | jq '.new_state' > "$TMP_STATE" && [[ -s "$TMP_STATE" ]]; then
      mv -f "$TMP_STATE" "$STATE_FILE"
    else
      rm -f "$TMP_STATE"
    fi
  fi
  exit 0
fi

cat << EOF
PERSONA="${MONIKER}"
SLUG="${SLUG}"
HOST="${HOST_SHORT}"
ARCH="${ARCH_TAG}"
TIME_PT="${NOW_PT}"
SESSION="${SESSION_SHORT}"
WORKSPACE="${WORKSPACE}"
HAS_CORP_FOG_GGH="${HAS_GGH}"
HAS_OSS_GITHUB_GH="${HAS_GH}"

--- Markdown Envelope ---
$(print_header)
EOF
